{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": ".",
        "outDir": "./dist",

        "strict": true,

        "types": ["node"],

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,

        "resolveJsonModule": true,

        "declaration": true,
        "sourceMap": true
    },

    "include": [
        "src",
        "generated"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
